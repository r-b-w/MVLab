      "code_hash": "8cc8403e56253a6fa32e02a546ee1c96",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<marimo-ui-element object-id='SFPL-32' random-id='b13b2706-8ce3-6e90-22bf-c5c4c771d7fa'><marimo-form data-initial-value='null' data-label='null' data-element-id='&quot;SFPL-31&quot;' data-loading='false' data-bordered='true' data-submit-button-label='&quot;Submit&quot;' data-submit-button-disabled='false' data-clear-on-submit='false' data-show-clear-button='false' data-clear-button-label='&quot;Clear&quot;' data-should-validate='false'><marimo-ui-element object-id='SFPL-31' random-id='b7ce6768-1965-dbc3-0f00-fa5e85cddbd1'><marimo-dict data-initial-value='{&quot;mass&quot;:{&quot;i11&quot;:0.0,&quot;i21&quot;:0.0,&quot;i22&quot;:0.0},&quot;stif&quot;:{&quot;i11&quot;:0.0,&quot;i21&quot;:0.0,&quot;i22&quot;:0.0}}' data-label='null' data-element-ids='{&quot;SFPL-26&quot;:&quot;mass&quot;,&quot;SFPL-30&quot;:&quot;stif&quot;}'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Please enter mass and stiffness matrices. </span>\n<span class=\"paragraph\">Enter only the lower triangular factor, the upper factor will be filled in using symmetry.</span>\n<span class=\"paragraph\">Use dots or commas for decimal numbers according to your operating system configuration!</span>\n<span class=\"paragraph\"><marimo-ui-element object-id='SFPL-26' random-id='2b950297-f883-4959-69c1-0c2f7c0f014a'><marimo-dict data-initial-value='{&quot;i11&quot;:0.0,&quot;i21&quot;:0.0,&quot;i22&quot;:0.0}' data-label='null' data-element-ids='{&quot;SFPL-23&quot;:&quot;i11&quot;,&quot;SFPL-24&quot;:&quot;i21&quot;,&quot;SFPL-25&quot;:&quot;i22&quot;}'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong><em>Mass matrix</em></strong>:</span> <div class=\"container\"> 1: <div class=\"inline-box\"> <marimo-ui-element object-id='SFPL-23' random-id='4c3e1709-7a91-4535-6470-43180e420f8b'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div> <div class=\"container\"> 2: <div class=\"inline-box\"> <marimo-ui-element object-id='SFPL-24' random-id='ef25ab0f-ee9b-80b3-93cc-f0a4b5ad2185'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> <div class=\"inline-box\"> <marimo-ui-element object-id='SFPL-25' random-id='0027491e-f369-ddad-8bb0-ad295476cd4d'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div></span></marimo-dict></marimo-ui-element></span>\n<span class=\"paragraph\"><marimo-ui-element object-id='SFPL-30' random-id='66e9cf8a-9e20-4dd8-8e20-61ac47825ece'><marimo-dict data-initial-value='{&quot;i11&quot;:0.0,&quot;i21&quot;:0.0,&quot;i22&quot;:0.0}' data-label='null' data-element-ids='{&quot;SFPL-27&quot;:&quot;i11&quot;,&quot;SFPL-28&quot;:&quot;i21&quot;,&quot;SFPL-29&quot;:&quot;i22&quot;}'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong><em>Stiffness matrix</em></strong>:</span> <div class=\"container\"> 1: <div class=\"inline-box\"> <marimo-ui-element object-id='SFPL-27' random-id='f1b42e92-6547-e312-e91e-37eab5e873cd'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div> <div class=\"container\"> 2: <div class=\"inline-box\"> <marimo-ui-element object-id='SFPL-28' random-id='95acb0b4-1aa7-c309-a780-ba93a084f6f1'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> <div class=\"inline-box\"> <marimo-ui-element object-id='SFPL-29' random-id='42a9ea13-861e-7568-693b-d979631d6b84'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div></span></marimo-dict></marimo-ui-element></span></span></marimo-dict></marimo-ui-element></marimo-form></marimo-ui-element>"
