          "type": "data",
          "data": {
            "text/html": "<marimo-ui-element object-id='ZHCJ-56' random-id='67e422bd-a7cb-e3e8-34dd-bb153b931c15'><marimo-form data-initial-value='null' data-label='null' data-element-id='&quot;ZHCJ-55&quot;' data-loading='false' data-bordered='true' data-submit-button-label='&quot;Submit&quot;' data-submit-button-disabled='false' data-clear-on-submit='false' data-show-clear-button='false' data-clear-button-label='&quot;Clear&quot;' data-should-validate='false'><marimo-ui-element object-id='ZHCJ-55' random-id='ba8fa23c-8a90-f6b2-11ca-ecbfb0266abe'><marimo-dict data-initial-value='{&quot;mass&quot;:{&quot;i11&quot;:0.0,&quot;i21&quot;:0.0,&quot;i22&quot;:0.0,&quot;i31&quot;:0.0,&quot;i32&quot;:0.0,&quot;i33&quot;:0.0},&quot;stif&quot;:{&quot;i11&quot;:0.0,&quot;i21&quot;:0.0,&quot;i22&quot;:0.0,&quot;i31&quot;:0.0,&quot;i32&quot;:0.0,&quot;i33&quot;:0.0}}' data-label='null' data-element-ids='{&quot;ZHCJ-47&quot;:&quot;mass&quot;,&quot;ZHCJ-54&quot;:&quot;stif&quot;}'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Please enter mass and stiffness matrices. </span>\n<span class=\"paragraph\">Enter only the lower triangular factor, the upper factor will be filled in using symmetry.</span>\n<span class=\"paragraph\">Use dots or commas for decimal numbers according to your operating system configuration!</span>\n<span class=\"paragraph\"><marimo-ui-element object-id='ZHCJ-47' random-id='b2542747-6ecd-7d91-7bb4-3983e547b81f'><marimo-dict data-initial-value='{&quot;i11&quot;:0.0,&quot;i21&quot;:0.0,&quot;i22&quot;:0.0,&quot;i31&quot;:0.0,&quot;i32&quot;:0.0,&quot;i33&quot;:0.0}' data-label='null' data-element-ids='{&quot;ZHCJ-41&quot;:&quot;i11&quot;,&quot;ZHCJ-42&quot;:&quot;i21&quot;,&quot;ZHCJ-43&quot;:&quot;i22&quot;,&quot;ZHCJ-44&quot;:&quot;i31&quot;,&quot;ZHCJ-45&quot;:&quot;i32&quot;,&quot;ZHCJ-46&quot;:&quot;i33&quot;}'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong><em>Mass matrix</em></strong>:</span> <div class=\"container\"> 1: <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-41' random-id='94d35c97-bbd6-e740-9d65-aa1271150fa6'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div> <div class=\"container\"> 2: <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-42' random-id='4e20da15-d68d-63a7-1fbe-0e8b0085cefe'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-43' random-id='73c702b8-c642-bcf2-f6de-c6163377296e'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div> <div class=\"container\"> 3: <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-44' random-id='1fef0238-32e5-2c2f-ed88-cdf535958a22'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-45' random-id='d5f1310e-d493-6acf-6648-dc5875544057'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-46' random-id='fbebb51d-fbe6-9e79-1744-dc6b9e88254d'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div></span></marimo-dict></marimo-ui-element></span>\n<span class=\"paragraph\"><marimo-ui-element object-id='ZHCJ-54' random-id='2a172210-188b-8b07-cee4-3a484cc844be'><marimo-dict data-initial-value='{&quot;i11&quot;:0.0,&quot;i21&quot;:0.0,&quot;i22&quot;:0.0,&quot;i31&quot;:0.0,&quot;i32&quot;:0.0,&quot;i33&quot;:0.0}' data-label='null' data-element-ids='{&quot;ZHCJ-48&quot;:&quot;i11&quot;,&quot;ZHCJ-49&quot;:&quot;i21&quot;,&quot;ZHCJ-50&quot;:&quot;i22&quot;,&quot;ZHCJ-51&quot;:&quot;i31&quot;,&quot;ZHCJ-52&quot;:&quot;i32&quot;,&quot;ZHCJ-53&quot;:&quot;i33&quot;}'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong><em>Stiffness matrix</em></strong>:</span> <div class=\"container\"> 1: <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-48' random-id='19065c5b-f690-9961-f158-7e936035243a'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div> <div class=\"container\"> 2: <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-49' random-id='4f81cdd3-5fb1-025f-1377-1098fb7c10af'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-50' random-id='6c143894-1cf3-64d6-3d9c-350c6bc69be6'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div> <div class=\"container\"> 3: <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-51' random-id='52851379-a8f5-93ea-0e28-7051b7b40be3'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-52' random-id='35c402d7-aa8d-3118-4203-7b0c989087b0'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> <div class=\"inline-box\"> <marimo-ui-element object-id='ZHCJ-53' random-id='e201050b-1896-d600-337a-6f9a4919b675'><marimo-number data-initial-value='0.0' data-label='null' data-debounce='false' data-full-width='true' data-disabled='false'></marimo-number></marimo-ui-element> </div> </div></span></marimo-dict></marimo-ui-element></span></span></marimo-dict></marimo-ui-element></marimo-form></marimo-ui-element>"
